@startuml
!pragma useLayout legacy
skinparam backgroundColor transparent
skinparam defaultFontName "PingFang SC"
skinparam defaultFontSize 14
skinparam RankSep 50
skinparam NodeSep 40
skinparam shadowing false
skinparam ArrowThickness 1

title 邮箱找回密码流程

start

:用户请求发送邮箱验证码;
if (用户存在?) then (是)
  :写入 Redis 验证码+TTL;
  :发送邮件通知;
else (否)
  :返回 404;
  stop
endif

:用户提交验证码;
if (验证码有效且未过期?) then (是)
  :签发 reset_token(JWT+jti,exp);
  :缓存 jti→email 映射;
else (否)
  :返回 400;
  stop
endif

:用户调用重置密码;
:读取 header x-reset-token;
if (reset_token 解码成功且 jti 未消费?) then (是)
  :校验密码强度;
  :bcrypt 更新用户密码;
  :标记 jti 已消费 (Redis setex);
  :返回 200;
else (否)
  :返回 400/401;
endif

stop
@enduml
